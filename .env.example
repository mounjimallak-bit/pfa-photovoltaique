
# --- Kafka ---
# Depuis votre machine : localhost:9092 ; depuis un conteneur du réseau compose : kafka:29092
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_MEASUREMENTS=measurements
KAFKA_TOPIC_ALARMS=alarms
KAFKA_GROUP_ID=pfa-detecteur
KAFKA_REQUEST_TIMEOUT_MS=10000
# Doit être >= KAFKA_REQUEST_TIMEOUT_MS
ALARM_DELIVERY_TIMEOUT_MS=30000

# --- Replay ---
# En dessous d'environ 0.4 s, le consumer prend du retard (10 réseaux par point)
REPLAY_DELAY_S=1.0

# --- PostgreSQL / TimescaleDB ---
# Changer le mot de passe n'a d'effet sur la base qu'à sa création :
# sur un volume existant, faire docker compose down -v (efface les données).
PGHOST=localhost
PGPORT=5432
PGDATABASE=photovoltaique
PGUSER=pfa
PGPASSWORD=pfa2026
PGCONNECT_TIMEOUT=5
